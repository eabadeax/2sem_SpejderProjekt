
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>De Lyserøde Spejdere</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>
<body>

    <nav class="navbar navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                De Lyserøde Spejdere
            </a>


            <div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="me-2">
                        Hej, @User.Identity.Name
                    </span>

                    <form method="post"
                          asp-page="/Account/Login"
                          asp-page-handler="Logout"
                          class="d-inline">

                        <button type="submit" class="btn btn-secondary">
                            Log ud
                        </button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login"
                       class="btn btn-primary">
                        Log ind
                    </a>
                }


                <a asp-page="/Index" class="btn btn-outline-primary">
                    Forside
                </a>

                <a asp-page="/Activities/Index" class="btn btn-outline-primary">
                    Aktiviteter
                </a>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

</body>
</html>