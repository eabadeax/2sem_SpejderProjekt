@page
@model _2sem_SpejderProjekt.Pages.Activities.DeleteModel

<h1>Slet aktivitet</h1>

<p>Er du sikker på, at du vil slette "@Model.Activity.Name"?</p>

<p class="text-danger">
    OBS: Hvis du sletter aktiviteten, bliver alle tilmeldinger
    til aktiviteten også slettet.
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="text-danger">@Model.ErrorMessage</p>
}

<form method="post">

    <input type="hidden" name="id"
           value="@Model.Activity.ActivityId" />

    <button type="submit" class="btn btn-danger">
        Slet aktivitet
    </button>

    <a asp-page="./Index" class="btn btn-secondary">
        Annuller
    </a>

</form>
