@page
@model _2sem_SpejderProjekt.Pages.Activities.IndexModel

<h1>Aktiviteter</h1>

<p>Oversigt over spejderlejrens aktiviteter.</p>

<a asp-page="./Create" class="btn btn-primary mb-3">
    Opret aktivitet
</a>

@if (Model.Activities.Count == 0)
{
    <p>Der er endnu ingen aktiviteter oprettet.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Beskrivelse</th>
                <th>Dato</th>
                <th>Start</th>
                <th>Slut</th>
                <th>Max deltagere</th>
                <th>Handlinger</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var activity in Model.Activities)
            {
                <tr>
                    <td>@activity.Name</td>
                    <td>@activity.Description</td>
                    <td>@activity.Date.ToString("dd-MM-yyyy")</td>
                    <td>@activity.StartTime.ToString(@"hh\:mm")</td>
                    <td>@activity.EndTime.ToString(@"hh\:mm")</td>
                    <td>@activity.MaxParticipants</td>
                    <td>
                        <a asp-page="./Edit"
                           asp-route-id="@activity.ActivityId"
                           class="btn btn-primary btn-sm">
                            Rediger
                        </a>

                        <a asp-page="./Delete"
                           asp-route-id="@activity.ActivityId"
                           class="btn btn-danger btn-sm">
                            Slet
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-page="/Index" class="btn btn-secondary">
    Tilbage til forsiden
</a>